package main

import (
	_ "embed"
	"log"

	"github.com/linxlib/fw/v2/app"
)

//go:generate go run github.com/linxlib/fw/v2/astp/cmd/astp -exported .

//go:embed .astp.json
var astpData []byte

func main() {
	e, err := app.New("config/app.yaml")
	if err != nil {
		panic(err)
	}

	e.EmbedProject(astpData)

	// Controllers, middlewares and services are auto-registered by generated code.

	log.Println("starting server ...")
	if err := e.ListenAndServe(); err != nil {
		panic(err)
	}
}
