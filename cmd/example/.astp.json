          "doc": {
            "list": [
              {
                "text": "SSEMiddleware sets up a Server-Sent Events stream. The middleware calls"
              },
              {
                "text": "ctx.SSE() to establish the stream, then invokes next inside the stream"
              },
              {
                "text": "callback so the handler can use the SSEWriter to push events."
              },
              {
                "text": ""
              },
              {
                "text": "The handler method receives *ctxpkg.SSEWriter as a parameter via DI."
              }
            ]
          }
